# Copy this file to .env and fill in real values before running.
# .env itself is gitignored — never commit real secrets.

# Shared secret used to verify the HMAC signature on incoming webhooks
# from the warehouse vendor.
WEBHOOK_SECRET=change-me-to-a-real-secret

# API key required by the support tool (or any other reader) to call
# GET /stock/:sku.
READ_API_KEY=change-me-to-a-real-key

# Path to the SQLite database file. Defaults to ./stock.db if unset.
DB_PATH=./stock.db

# How old (in ms) a reading can be before /health flags its SKU as
# stale. Defaults to 15 minutes if unset.
STALE_THRESHOLD_MS=900000
